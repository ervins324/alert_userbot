# Neptun → Telegram MTProto forwarder configuration
# Copy to .env and fill in the values.

# WebSocket stream URL (optional, defaults to this)
NEPTUN_WS_URL=wss://neptun.in.ua/api/v1/stream

# REQUIRED: Telegram Bot API token (from @BotFather).
# The bot sends the messages to your chat; the userbot only reads the channel.
TELEGRAM_BOT_TOKEN=

# REQUIRED: Telegram API credentials (get at https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Phone number in international format (e.g. 380501234567).
# Only needed for first-time login; afterwards the session file is reused.
TG_PHONE=
# Optional 2FA password (leave empty if not set)
TG_PASSWORD=
# Optional: auto-enter the login code from this env instead of stdin.
# Delete it after first successful login.
# TG_AUTH_CODE=

# Session file persisted after first login. Keep it safe.
SESSION_FILE=session.bin

# REQUIRED: destination chat (your DM with the bot).
DESTINATION_CHAT_ID=

# Public channel whose posts get forwarded while Kyiv has an air alert.
# Use a @username or a -100... channel ID (private channel you are in).
SOURCE_CHANNEL=mon1tor_ua

# Extra comma-separated substrings to skip (donation posts, etc.).
# Default donation/fundraising patterns are always active.
# SKIP_PATTERNS=підписка,реклама

# Optional tuning
MIN_RECONNECT_INTERVAL=1s
MAX_RECONNECT_INTERVAL=30s
QUEUE_CAPACITY=1000
HTTP_TIMEOUT=10s

# Treat the alert as always active (testing only)
# FORCE_ALERT=true

# Optional: Google Maps Static API Key (for native Google Maps rendering)
# If empty, a high-resolution real street map tile renderer is used automatically.
# GOOGLE_MAPS_API_KEY=
